# BEAT Environment Example
# Use this file as a reference when preparing deployment/docker-compose/dfxw/.env.
# The quickstart script may also generate the runtime .env interactively.
#
# Do not put real production secrets, customer data, private service URLs, or internal credentials
# into the public repository. Replace placeholder values with your own local or evaluation settings.
#
# For local evaluation, keep the default registry/tag values generated by the quickstart script
# unless you are building images manually.

# -----------------------------------------------------------------------------
# Basic deployment settings
# -----------------------------------------------------------------------------

host_ip=127.0.0.1
TAG=latest
REGISTRY=localhost:5000
TIMEZONE=Asia/Shanghai

# Web UI
EKBA_UI_PORT=5174
EKBA_DATAPREP_PORT=6007
EKBA_MINI_UI_PORT=5175
EAP_RETRIEVER_PORT=17001

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# RAG / vector database settings
# -----------------------------------------------------------------------------

MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
COLLECTION_NAME=mes_sop
ENABLE_RERANK=true
OUTSTANDING_SCORE=0

# -----------------------------------------------------------------------------
# LLM configuration
# -----------------------------------------------------------------------------
# The services support OpenAI-compatible or vendor-compatible model endpoints.
# Replace the endpoint, model, and API key with your own evaluation configuration.

DATAPREP_LLM_PROVIDER=openai-compatible
DATAPREP_LLM_ENDPOINT=http://localhost:8000/v1
DATAPREP_LLM_MODEL=qwen-or-compatible-model
DATAPREP_LLM_API_KEY=replace-with-your-api-key

SMART_PRACTICE_LLM_PROVIDER=openai-compatible
SMART_PRACTICE_LLM_ENDPOINT=http://localhost:8000/v1
SMART_PRACTICE_LLM_MODEL=qwen-or-compatible-model
SMART_PRACTICE_LLM_API_KEY=replace-with-your-api-key

ASR_LLM_MODEL=qwen-or-compatible-model

# -----------------------------------------------------------------------------
# Embedding configuration
# -----------------------------------------------------------------------------

BAILIAN_EMBEDDING_ENDPOINT=http://localhost:8080/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-compatible-model
BAILIAN_EMBEDDING_API_KEY=replace-with-your-api-key

# Optional local / TEI / OVMS compatible settings
EMBEDDING_RERANKER_BACKEND=
TEI_EMBEDDING_ENDPOINT=
TEI_RERANKING_ENDPOINT=
OVMS_EMBEDDING_ENDPOINT=
OVMS_EMBEDDING_MODEL=
OVMS_RERANKING_ENDPOINT=
OVMS_RERANKING_MODEL=
LOCAL_EMBEDDING_MODEL=maidalun1020/bce-embedding-base_v1
embedding_ctx_length=510

# -----------------------------------------------------------------------------
# ASR configuration
# -----------------------------------------------------------------------------
# Leave ASR_ENDPOINT empty if ASR is not used in the evaluation demo.
# Use a local or authorized remote endpoint if video/audio processing is enabled.

ASR_PROVIDER=env
ASR_TRANSPORT=http
ASR_ENGINE=qwen
ASR_ENDPOINT=
ASR_MODEL=
ASR_API_KEY=
ASR_SSL_VERIFY=false
ASR_RUNTIME_OPTIONS_JSON=

# Local faster-whisper mode, optional
ASR_WHISPER_MODEL_SIZE=medium
ASR_WHISPER_DEVICE=auto
ASR_WHISPER_COMPUTE_TYPE=default
ASR_WHISPER_MODEL_PATH=/opt/models/faster-whisper-medium
HF_HUB_OFFLINE=1

# -----------------------------------------------------------------------------
# Document parsing / Magic PDF configuration
# -----------------------------------------------------------------------------
# Leave MAGIC_PDF_PARSE_URL empty if remote parsing is not used.

MAGIC_PDF_MODEL_PATH=/opt/models
MAGIC_PDF_REMOTE_ENABLED=false
MAGIC_PDF_PARSE_URL=
MAGIC_PDF_PARSE_METHOD=auto
MAGIC_PDF_PARSE_LANG=ch_server
MAGIC_PDF_PARSE_CONNECT_TIMEOUT=10
MAGIC_PDF_PARSE_TIMEOUT=600
MAGIC_PDF_PARSE_READ_TIMEOUT=600
MAGIC_PDF_PARSE_RETRIES=2
MAGIC_PDF_PARSE_RETRY_BACKOFF_SECONDS=1.5

# -----------------------------------------------------------------------------
# Practice and learning workflow
# -----------------------------------------------------------------------------

TOTAL_ROUNDS=10
MAX_SUPPLEMENT_ROUNDS=3
TIME_LIMIT=600
DATAPREP_QA_CONCURRENCY_LIMIT=3
PROMPT_LANGUAGE=en

# -----------------------------------------------------------------------------
# Database settings
# -----------------------------------------------------------------------------

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=ekba_kb

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=OPEA_EAP
MONGO_COLLECTION_NAME=ChatHistory
USER_LOGS_COLLECTION_NAME=UserLogs

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=change-me
REDIS_DB=0
SESSION_REDIS_PREFIX=sp:exam:session:
TIME_REDIS_PREFIX=sp:exam:global_timer:

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# Recommended for local evaluation: FILES_STORED_TYPE=minio

DATA_LOADER_TYPE=local
FILES_STORED_TYPE=minio

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=eap
MINIO_PREFIX=ai-doc
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional Aliyun OSS configuration. Leave empty unless OSS is used.
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_DEST_PREFIX=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# -----------------------------------------------------------------------------
# External enterprise system integration, optional
# -----------------------------------------------------------------------------

DFXW_BASE_URL=
DFXW_TOKEN_URL=
DFXW_CLIENT_ID=
DFXW_CLIENT_SECRET=
JWT_EXPIRATION_DELTA=86400

# -----------------------------------------------------------------------------
# UI service routing inside Docker Compose
# -----------------------------------------------------------------------------

SOP_API_HOST=dataprep:6010
CHAT_API_HOST=smart-practice-usvc:9010
COMPANY_API_HOST=system-common:8010
CHAT_HISTORY_API_HOST=chathistory:6022
USER_API_HOST=account:9011
LEARN_API_HOST=learn:7010
VIDEO_API_HOST=video:8000
VIDEO_API_HOST_V2=excel:8001
DASHBOARD_API_HOST=dashboard:6020

# -----------------------------------------------------------------------------
# Security / model configuration
# -----------------------------------------------------------------------------
# Replace with your own Fernet key if encrypted model configuration is enabled.

MODEL_CONFIG_ENCRYPTION_KEYS=replace-with-your-fernet-key
ACCOUNT_SECRET_KEY=replace-with-your-jwt-secret
JWT_ALGORITHM=HS256
PASSING_SCORE=60
